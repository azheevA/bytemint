# Required for canonical metadata, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enable AdSense only after account approval and consent setup.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=

# Optional affiliate destinations. Only use links from programs that approved your account.
NEXT_PUBLIC_AFFILIATE_HOSTING_URL=
NEXT_PUBLIC_AFFILIATE_AI_URL=

# Optional checkout page for a paid digital product (e.g. hosted checkout).
NEXT_PUBLIC_PREMIUM_PRODUCT_URL=

# Contact form. The sender domain must be verified with Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Production abuse protection. Required for contact API in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HASH_SECRET=